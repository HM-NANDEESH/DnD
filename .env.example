NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SESSION_TTL_SECONDS=86400
REFRESH_TOKEN_REMEMBER_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=dnd_refresh_token
AUTH_COOKIE_SECURE=false

OTP_EXPIRES_MINUTES=10
OTP_COOLDOWN_SECONDS=45

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="DnD <no-reply@example.com>"

# Twilio SMS (Optional - Fallbacks to console simulation if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase Auth Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
