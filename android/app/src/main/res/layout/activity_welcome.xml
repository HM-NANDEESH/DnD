<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:padding="28dp">

    <!-- Centered Header and Logo Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true">

        <!-- Logo Container with Glow -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Glowing background circles under Logo -->
            <View
                android:id="@+id/logo_glow"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_glow"
                android:alpha="0.15" />

            <!-- Logo Badge -->
            <RelativeLayout
                android:id="@+id/welcome_logo_badge"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_logo_badge"
                android:gravity="center"
                android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DnD"
                android:textColor="#ffffff"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="-0.04" />
        </RelativeLayout>
        </FrameLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/welcome_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Forge Discipline.\nBuild Consistency."
            android:textColor="#ffffff"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

        <!-- Description -->
        <TextView
            android:id="@+id/welcome_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="Stack wins, build consistency, and level up your daily game. Your rules, your goals, your playground."
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp">

        <!-- Primary Sign Up CTA -->
        <RelativeLayout
            android:id="@+id/btn_welcome_signup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Start Your Journey"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Secondary Log In CTA -->
        <RelativeLayout
            android:id="@+id/btn_welcome_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="I already have an account"
                android:textColor="#e2e8f0"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
