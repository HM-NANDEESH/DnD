<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DnD"
            android:textColor="#ffffff"
            android:textSize="38sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log in to DnD"
            android:textColor="#94a3b8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="28dp" />

        <!-- Login Main Content Wrapper -->
        <LinearLayout
            android:id="@+id/layout_login_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- SSO Container -->
            <LinearLayout
                android:id="@+id/layout_login_sso_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- Google SSO Button -->
                <RelativeLayout
                    android:id="@+id/btn_sso_google"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sso_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Continue with Google"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Apple SSO Button -->
                <RelativeLayout
                    android:id="@+id/btn_sso_apple"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sso_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Continue with Apple"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Phone SSO Button -->
                <RelativeLayout
                    android:id="@+id/btn_sso_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sso_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Continue with Phone number"
                        android:textColor="#ffffff"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Divider -->
            <LinearLayout
                android:id="@+id/layout_login_divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#15ffffff" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="or"
                    android:textColor="#64748b"
                    android:textSize="12sp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#15ffffff" />
            </LinearLayout>

            <!-- Email/Username Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email or username"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:layout_marginLeft="12dp" />
                <EditText
                    android:id="@+id/input_login_username"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email or username"
                    android:textColorHint="#475569"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:singleLine="true"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Password Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:layout_marginLeft="12dp" />
                <EditText
                    android:id="@+id/input_login_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:textColorHint="#475569"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:singleLine="true"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btn_login_submit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_button"
                android:text="Log In"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="20dp" />

            <!-- Forgot Password Link -->
            <TextView
                android:id="@+id/link_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forgot your password?"
                android:textColor="#94a3b8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="30dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#08ffffff"
                android:layout_marginBottom="20dp" />

            <!-- Footer Navigation -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="#64748b"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/link_goto_signup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up for DnD"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP: PHONE NUMBER ENTRY -->
        <LinearLayout
            android:id="@+id/layout_login_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Your Phone Number"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="The phone number will be used for account verification and security purposes."
                android:textColor="#94a3b8"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="4dp"
                android:lineSpacingMultiplier="1.2" />

            <!-- Country Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Country / Region"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginLeft="4dp" />

            <Spinner
                android:id="@+id/spinner_login_country"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="16dp" />

            <!-- Phone Input Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:layout_marginLeft="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/text_login_dial_code"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_sso_button"
                    android:gravity="center"
                    android:text="+91"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_marginRight="8dp" />

                <EditText
                    android:id="@+id/input_login_phone"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:hint="Phone number"
                    android:textColorHint="#475569"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:singleLine="true"
                    android:inputType="phone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ A verification code will be sent to the entered phone number. Standard carrier charges may apply. The verification code is used only for authentication and security. The phone number will help protect and recover the account."
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="24dp"
                android:layout_marginLeft="4dp"
                android:lineSpacingMultiplier="1.2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_login_phone_back"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sso_button"
                    android:text="Back"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:layout_marginRight="8dp"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/btn_login_phone_submit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_pill_button"
                    android:text="Send OTP"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- STEP: OTP VERIFICATION -->
        <LinearLayout
            android:id="@+id/layout_login_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Your Phone Number"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"
                android:layout_marginLeft="4dp" />

            <TextView
                android:id="@+id/text_login_otp_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="We've sent a 6-digit verification code to your phone number."
                android:textColor="#94a3b8"
                android:textSize="13sp"
                android:layout_marginBottom="24dp"
                android:layout_marginLeft="4dp"
                android:lineSpacingMultiplier="1.2" />

            <!-- 6 OTP Boxes Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/input_login_otp_1"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />
                <EditText
                    android:id="@+id/input_login_otp_2"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />
                <EditText
                    android:id="@+id/input_login_otp_3"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />
                <EditText
                    android:id="@+id/input_login_otp_4"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />
                <EditText
                    android:id="@+id/input_login_otp_5"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="6dp" />
                <EditText
                    android:id="@+id/input_login_otp_6"
                    android:layout_width="40dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ OTP is valid only for a limited duration. Never share your verification code with anyone. DnD will never ask for your OTP outside the verification process. Request a new code if the current one expires."
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="4dp"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/text_login_otp_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend code in 59s"
                android:textColor="#94a3b8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_login_otp_back"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sso_button"
                    android:text="Edit Number"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:layout_marginRight="8dp"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/btn_login_otp_submit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_pill_button"
                    android:text="Verify OTP"
                    android:textColor="#ffffff"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
